[sub_resource type="GDScript" id="GDScript_4otcc"]
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text =\"Hp : \" + str(Game.playerHP)
"

[sub_resource type="GDScript" id="GDScript_aqk2v"]
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text =\"Gold : \" + str(Game.Gold)
"

[sub_resource type="GDScript" id="GDScript_obxai"]
script/source = "extends Node2D

'''var cherry = preload(\"res://collectables/cherry.tscn\")
var gem =preload(\"res://collectables/gem.tscn\")
func _on_timer_timeout() -> void:
	var cherryTemp = cherry.instantiate()
	var gemTemp =gem.instantiate()
	var rng =RandomNumberGenerator.new()
	var randit = rng.randi_range(10,1800)
	cherryTemp.position= Vector2(randit,390)
	add_child(cherryTemp)'''
"

